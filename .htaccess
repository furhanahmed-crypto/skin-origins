# Skin Origins — pretty URLs matching live SEO paths
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Service treatment details
  RewriteRule ^(skin|hair|wellness)/([^/]+)/?$ $1/index.php [L,QSA]

  # Blog details
  RewriteRule ^blog/([^/]+)/?$ blog/index.php [L,QSA]

  # Blog listing
  RewriteRule ^blogs/?$ blogs/index.php [L,QSA]
</IfModule>

DirectoryIndex index.php
